# Copy to .env and edit. `docker compose up` reads .env automatically.

# Signs the seat tokens that prove a returning player owns their seat. Anyone
# who knows this value can forge one for any seat in any room, so it must be
# yours and secret. Left deliberately empty: compose refuses to start until you
# fill it in.
#
#   openssl rand -hex 32
SESSION_SECRET=

# Host ports. Change these if 3000/3001 are taken — but note that the published
# web image expects the game server on localhost:3001 specifically, so changing
# SERVER_PORT means rebuilding the web image (see docker-compose.build.yml).
WEB_PORT=3000
SERVER_PORT=3001

# Your machine's architecture. linux/amd64 is the default because that is what
# CI publishes; set linux/arm64 when building locally on Apple Silicon.
# IMAGE_PLATFORM=linux/arm64

# Only used when building (docker-compose.build.yml). These are compiled into
# the client bundle, so they must be the URLs a player's browser will use.
# An https API must pair with a wss socket on the same host, or the browser
# blocks the connection as mixed content.
# PUBLIC_SERVER_URL=https://cards-api.example.com
# PUBLIC_WS_URL=wss://cards-api.example.com/ws
